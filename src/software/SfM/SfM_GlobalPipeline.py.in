#!/usr/bin/python
#! -*- encoding: utf-8 -*-

# This file is part of OpenMVG (Open Multiple View Geometry) C++ library.

# Python implementation of the bash script written by Romuald Perrot
# Created by @vins31
# Modified by Pierre Moulon
#
# this script is for easy use of OpenMVG
#
# usage : python openmvg.py image_dir output_dir
#
# image_dir is the input directory where images are located
# output_dir is where the project must be saved
#
# if output_dir is not present script will create it
#

# Indicate the openMVG binary directory
OPENMVG_SFM_BIN = "@OPENMVG_SOFTWARE_SFM_BUILD_DIR@"

# Indicate the openMVG camera sensor width directory
CAMERA_SENSOR_WIDTH_DIRECTORY = "@OPENMVG_SOFTWARE_SFM_SRC_DIR@" + "/../../openMVG/exif/sensor_width_database"

import argparse
import os
import subprocess
import sys
import time

parser = argparse.ArgumentParser(description="Runs the SfM global pipeline E2E.",
                                 formatter_class=argparse.ArgumentDefaultsHelpFormatter)

parser.add_argument("-fm", "--describerMethod", type=str, default="SIFT", help="Feature describer method.")
parser.add_argument("-fp", "--describerPreset", type=str, default="NORMAL", help="Feature describer preset.")
parser.add_argument("-mr", "--ratio", type=float, default=0.8, help="Matching ratio threshold.")
parser.add_argument("--imu_rotation_weight", type=float, default=0.0, help="IMU rotation prior weight (0 disables).")
parser.add_argument("--imu_rotation_max_error", type=float, default=45.0, help="Max error (deg) for IMU prior filtering.")
parser.add_argument("--imu_rotation_histogram_bucket", type=float, default=10.0, help="IMU error histogram bucket size (deg).")
parser.add_argument("--imu_rotation_filter_outliers", dest="imu_rotation_filter_outliers", action="store_true",
                    help="Enable IMU-based rotation outlier filtering in global SfM (off by default).")
parser.add_argument("--disable_reestimate_rotation", action="store_true",
                    help="Disable IMU geometric-filter rotation re-estimation pass.")
parser.add_argument("--imu_reestimate_prec", type=float, default=15.0,
                    help="Pixel threshold for IMU re-estimation pass (-Q).")
parser.add_argument("--imu_pitch_roll_only", action="store_true",
                    help="Use IMU pitch/roll only (ignore compass yaw) during IMU geometric filtering.")
parser.add_argument("--enable_close_time_adaptive_filtering", dest="close_time_adaptive_filtering", action="store_true",
                    help="Enable close-time adaptive filtering in global SfM (disabled by default).")
parser.add_argument("-gp", "--geofilt_prec", type=float, default=0.0, help="Geometric filter precision (max pixel error). Use 0.0 for Auto (found by RANSAC math).")
parser.add_argument("-mi", "--min_inliers", type=int, default=50, help="Minimum inlier count per pair.")
parser.add_argument("-ri", "--ransac_iter", type=int, default=1024, help="RANSAC iterations for geometric filter.")
parser.add_argument("--use_plain_geometric_filter", action="store_true",
                    help="Use openMVG_main_GeometricFilter with -g e (no priors), instead of openMVG_main_GeometricFilterWithPriors -g i.")
parser.add_argument("--excluded_pairs_file", type=str, default="",
                    help="Optional JSON file of excluded image pairs. If not set, uses matches/excluded_pairs.json when present.")
parser.add_argument("input_dir", help="Input directory containing the images.")
parser.add_argument("output_dir", help="Output directory where the project files will be saved.")

args = parser.parse_args()

input_dir = args.input_dir
output_dir = args.output_dir
matches_dir = os.path.join(output_dir, "matches")
reconstruction_dir = os.path.join(output_dir, "reconstruction_global")
camera_file_params = os.path.join(CAMERA_SENSOR_WIDTH_DIRECTORY, "sensor_width_camera_database.txt")

print ("Using input dir  : ", input_dir)
print ("      output_dir : ", output_dir)

# Create the ouput/matches folder if not present
if not os.path.exists(output_dir):
  os.mkdir(output_dir)
if not os.path.exists(matches_dir):
  os.mkdir(matches_dir)

log_path = os.path.join(output_dir, "SfM_GlobalPipeline.log")

def run_step(title, cmd, log_file):
  print (title)
  print ("Command: " + " ".join(cmd))
  log_file.write("== " + title + " ==\n")
  log_file.write("Command: " + " ".join(cmd) + "\n")
  log_file.flush()

  start_time = time.time()
  process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
  for line in iter(process.stdout.readline, b""):
    if not line:
      break
    if isinstance(line, bytes):
      text = line.decode("utf-8", "replace")
    else:
      text = line
    sys.stdout.write(text)
    log_file.write(text)
  process.stdout.close()
  process.wait()

  elapsed = time.time() - start_time
  summary = "{} finished in {:.2f} s (return code: {})\n".format(title, elapsed, process.returncode)
  print (summary.strip())
  log_file.write(summary)
  log_file.flush()
  return elapsed
with open(log_path, "a") as log_file:
  log_file.write("Pipeline log for: {}\n".format(time.ctime()))
  log_file.write("Input dir: {}\nOutput dir: {}\n".format(input_dir, output_dir))

  # Print git short hash for version tracking
  git_hash = "unknown"
  git_hash_file = os.environ.get("GIT_SHORT_HASH_FILE")
  if git_hash_file and os.path.exists(git_hash_file):
    try:
      with open(git_hash_file, "r") as f:
        git_hash = f.read().strip()
    except:
      pass

  git_info = "Git short hash: {}\n\n".format(git_hash)
  print(git_info.strip())
  log_file.write(git_info)
  log_file.flush()

  run_step("1. Intrinsics analysis",
           [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_SfMInit_ImageListing"), "-i", input_dir, "-o", matches_dir, "-d", camera_file_params],
           log_file)

  run_step("2. Compute features",
           [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_ComputeFeatures"), "-i", matches_dir+"/sfm_data.json", "-o", matches_dir, "-m", args.describerMethod, "-p", args.describerPreset],
           log_file)

  pairs_file = os.path.join(matches_dir, "pairs.bin")
  if not os.path.exists(pairs_file):
    run_step("3. Compute matching pairs",
             [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_PairGenerator"),
              "-i", matches_dir+"/sfm_data.json",
              "-o", pairs_file,
              # "-m", "COMPASS"
              ],
             log_file)
  else:
    print ("3. Compute matching pairs (skipped, pairs.bin exists)")
    log_file.write("== 3. Compute matching pairs (skipped, pairs.bin exists) ==\n")

  run_step("4. Compute matches",
           [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_ComputeMatches"), "-i", matches_dir+"/sfm_data.json", "-p", matches_dir+ "/pairs.bin", "-o", matches_dir + "/matches.putative.bin", "-r", str(args.ratio)],
           log_file)

  if args.use_plain_geometric_filter:
    mode_msg = "Geometric filter mode: e (plain essential, no priors)\n"
    print(mode_msg.strip())
    log_file.write(mode_msg)
    log_file.flush()
    # 5. Filter matches with original geometric filter (no priors).
    run_step("5. Filter matches with geometric filter (-g e, no priors)",
             [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_GeometricFilter"),
              "-i", matches_dir+"/sfm_data.json",
              "-m", matches_dir+"/matches.putative.bin",
              "-g", "e",
              "-o", matches_dir+"/matches.e.bin",
              "-I", str(args.ransac_iter),
              # "-c", "1000"   # Optional: Regions cache size (1000 images)
              ],
             log_file)
  else:
    # 5. Filter matches using IMU-guided 2-point essential matrix solver
    # This method uses IMU rotation data to:
    #   - Pre-filter matches using epipolar constraint (filters out 30-70% invalid matches)
    #   - Reduce RANSAC from 5-point to 2-point (known R, solve for t only)
    #   - Run only 64 RANSAC iterations instead of 1024+ (much faster!)
    # Result: ~4x speedup vs GPS heading method, more accurate filtering
    imu_model = "p" if args.imu_pitch_roll_only else "i"
    imu_mode_name = "p (IMU pitch/roll only)" if imu_model == "p" else "i (IMU full rotation)"
    mode_msg = "Geometric filter mode: {}\n".format(imu_mode_name)
    print(mode_msg.strip())
    log_file.write(mode_msg)
    log_file.flush()
    geofilt_cmd = [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_GeometricFilterWithPriors"),
                   "-i", matches_dir+"/sfm_data.json",
                   "-m", matches_dir+"/matches.putative.bin",
                   "-g", imu_model,     # IMU-guided solver (full R or pitch/roll-only)
                   "-o", matches_dir+"/matches.e.bin",
                   "-I", str(args.ransac_iter),    # Iterations
                   "-t", "50.0",   # RANSAC search limit (fixed bound)
                   "-M", str(args.min_inliers),    # Min inlier count per pair
                   "-T", str(args.geofilt_prec), # User-defined filter precision (0.0=Auto)
                   # "-c", "1000"   # Optional: Regions cache size (1000 images)
                   ]
    if not args.disable_reestimate_rotation:
      geofilt_cmd.append("-U")
    if args.imu_reestimate_prec is not None:
      geofilt_cmd.extend(["-Q", str(args.imu_reestimate_prec)])
    run_step("5. Filter matches with IMU-guided solver", geofilt_cmd, log_file)

  # 5b. Optional: Additional post-filtering by priors (now mostly redundant since priors are in step 5)
  # Uncomment if you want stricter filtering after RANSAC
  # run_step("5b. Filter matches by priors",
  #           [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_GeometricFilterByPriors"),
  #           "-i", os.path.join(matches_dir, "sfm_data.json"),
  #           "-m", os.path.join(matches_dir, "matches.e.bin"),
  #           "-o", os.path.join(matches_dir, "matches.e.priors.bin"),
  #           "-f", matches_dir,
  #           "-y", "15.0", # Yaw tolerance
  #           "-x", "10.0", # Pitch tolerance
  #           "-z", "10.0", # Roll tolerance
  #           "-a", "0.2"   # Altitude (ty) tolerance
  #           ],
  #           log_file)

  actual_matches = os.path.join(matches_dir, "matches.e.bin")

  # Create the reconstruction if not present
  if not os.path.exists(reconstruction_dir):
    os.mkdir(reconstruction_dir)

  excluded_pairs_file = args.excluded_pairs_file
  if not excluded_pairs_file:
    default_exclusions = os.path.join(matches_dir, "excluded_pairs.json")
    if os.path.exists(default_exclusions):
      excluded_pairs_file = default_exclusions

  if excluded_pairs_file:
    msg = "Using excluded pairs file: {}\n".format(excluded_pairs_file)
  else:
    msg = "No excluded pairs file found. Running SfM without exclusions.\n"
  print(msg.strip())
  log_file.write(msg)
  log_file.flush()

  sfm_cmd = [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_SfM"),
             "--sfm_engine", "GLOBAL",
             "--input_file", matches_dir+"/sfm_data.json",
             "--match_file", actual_matches,
             "--output_dir", reconstruction_dir,
             "--rotationAveraging", "1",
             "-P",
             "--imu_rotation_weight", str(args.imu_rotation_weight),
             "--imu_rotation_max_error", str(args.imu_rotation_max_error),
             "--imu_rotation_histogram_bucket", str(args.imu_rotation_histogram_bucket),
             "--imu_rotation_filter_outliers", "1" if args.imu_rotation_filter_outliers else "0",
            #  "--imu_rotation_filter_outliers", "1",
             "--close_time_adaptive_filtering", "1" if args.close_time_adaptive_filtering else "0"]
  if excluded_pairs_file:
    sfm_cmd.extend(["--excluded_pairs_file", excluded_pairs_file])

  run_step("6. Do Global reconstruction", sfm_cmd, log_file)

  # run_step("7. Colorize Structure",
  #          [os.path.join(OPENMVG_SFM_BIN, "openMVG_main_ComputeSfM_DataColor"), "-i", reconstruction_dir+"/sfm_data.bin", "-o", os.path.join(reconstruction_dir,"colorized.ply")],
  #          log_file)
